<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tech Nerds — notícias geek, tecnologia, games, anime, mangá, RPG e TCG." />
    <title>Tech Nerds</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <div class="brand-group">
          <span class="brand-mark">✦</span>
          <span class="brand-name">TECH NERDS</span>
        </div>

        <nav class="nav-main" aria-label="Menu principal">
          <a class="active" href="#">Início</a>
          <a href="#feed">Notícias</a>
          <a href="#stories">Stories</a>
          <a href="#chat">Comunidade</a>
          <a href="profile.html">Perfil</a>
        </nav>

        <div class="header-tools">
          <button class="tool-button search-toggle" aria-label="Buscar">⌕</button>
          <button class="tool-button" aria-label="Notificações">◔</button>
          <button class="tool-button chat-badge" aria-label="Mensagens">✦</button>
          <a href="login.html" class="account-button">VN</a>
        </div>
      </header>

      <div class="search-box" id="searchBox">
        <input id="searchInput" type="search" placeholder="Buscar notícias, games, tecnologia, anime..." />
      </div>

      <main class="main-grid">
        <aside class="left-panel">
          <section class="profile-card panel-card">
            <div class="profile-avatar">VN</div>
            <div class="profile-name-wrap">
              <strong>Vitor Nunes</strong>
              <span>@vitornerd</span>
            </div>
            <a href="profile.html" class="ghost-button">Meu perfil</a>
          </section>

          <nav class="side-menu panel-card" aria-label="Menu lateral">
            <a href="#" class="side-link active">⌂ Início</a>
            <a href="#feed" class="side-link">◌ Notícias</a>
            <a href="#stories" class="side-link">◍ Stories</a>
            <a href="#chat" class="side-link">✦ Comunidade</a>
            <a href="#" class="side-link">▣ Salvos</a>
          </nav>

          <section class="panel-card categories-card">
            <p class="section-kicker">Categorias</p>
            <div class="category-list">
              <button class="category-button active" data-filter="all">Todos</button>
              <button class="category-button" data-filter="tech">Tecnologia</button>
              <button class="category-button" data-filter="games">Games</button>
              <button class="category-button" data-filter="anime">Anime</button>
              <button class="category-button" data-filter="rpg">RPG / TCG</button>
            </div>
          </section>

          <section class="panel-card community-box">
            <span class="community-mark">✦</span>
            <h3>Comunidade nerd ativa</h3>
            <p>Analise, debata e compartilhe o melhor do universo geek.</p>
            <button class="primary-button small">Entrar</button>
          </section>
        </aside>

        <section class="center-column">
          <div class="stories-strip" id="stories">
            <div class="story-item story-add">
              <div class="story-avatar">＋</div>
              <span>Seu story</span>
            </div>
            <div class="story-item"><div class="story-avatar gradient-a">N</div><span>Nerds</span></div>
            <div class="story-item"><div class="story-avatar gradient-b">G</div><span>Game On</span></div>
            <div class="story-item"><div class="story-avatar gradient-c">A</div><span>Animes</span></div>
            <div class="story-item"><div class="story-avatar gradient-d">M</div><span>Mangás</span></div>
            <div class="story-item"><div class="story-avatar gradient-e">R</div><span>RPG</span></div>
            <div class="story-item"><div class="story-avatar gradient-f">T</div><span>Tecnologia</span></div>
          </div>

          <article class="feature-hero">
            <div class="hero-copy">
              <p class="eyebrow">Atualização diária · 25 set 2026</p>
              <h1>O futuro do entretenimento nerd está cada vez mais real.</h1>
              <p>IA, games, cultura pop, mangás e o que vem em seguida no universo geek.</p>
              <div class="hero-actions">
                <button class="primary-button">Ler matéria</button>
                <button class="ghost-button light">Seguir canal</button>
              </div>
            </div>
            <div class="hero-art" aria-hidden="true">
              <div class="orb orb-one"></div>
              <div class="orb orb-two"></div>
              <div class="hex">✦</div>
            </div>
          </article>

          <div class="feed-header" id="feed">
            <div>
              <p class="section-kicker">Feed editorial</p>
              <h2>O que está acontecendo hoje</h2>
            </div>
            <div class="feed-filters">
              <button class="mini-filter active" data-filter="all">Tudo</button>
              <button class="mini-filter" data-filter="tech">Tecnologia</button>
              <button class="mini-filter" data-filter="games">Games</button>
              <button class="mini-filter" data-filter="anime">Anime</button>
            </div>
          </div>

          <div id="newsList"></div>
        </section>

        <aside class="right-panel">
          <section class="panel-card">
            <div class="widget-head">
              <h3>Trending</h3>
              <a href="#">Ver tudo</a>
            </div>
            <div class="trend-list">
              <div class="trend-item">
                <span>01 · tecnologia</span>
                <strong>O que é computação quântica?</strong>
                <small>12,4 mil leituras</small>
              </div>
              <div class="trend-item">
                <span>02 · games</span>
                <strong>O retorno dos RPGs clássicos</strong>
                <small>8,7 mil leituras</small>
              </div>
              <div class="trend-item">
                <span>03 · geek</span>
                <strong>Cosplay: muito além da fantasia</strong>
                <small>5,2 mil leituras</small>
              </div>
            </div>
          </section>

          <section class="panel-card chat-box" id="chat">
            <div class="widget-head">
              <h3>Chat nerd</h3>
              <span class="status-live">●</span>
            </div>
            <div class="chat-thread">
              <div class="chat-message">
                <strong>Rafa:</strong>
                <p>Quem já viu o trailer do novo MMORPG? Parece incrível.</p>
              </div>
              <div class="chat-message">
                <strong>Mika:</strong>
                <p>Eu tô esperando a temporada do anime até a meia-noite.</p>
              </div>
              <div class="chat-message">
                <strong>Leo:</strong>
                <p>A IA dessa semana está me deixando em dúvida sobre o futuro.</p>
              </div>
            </div>
            <div class="chat-input-row">
              <input type="text" placeholder="Escreva no chat..." />
              <button>Enviar</button>
            </div>
          </section>

          <section class="panel-card newsletter-box">
            <p class="section-kicker purple">Newsletter</p>
            <h3>Receba o melhor do nerd.</h3>
            <p>Uma dose diária com as notícias mais relevantes.</p>
            <input type="email" placeholder="seu@email.com" />
            <button class="primary-button full">Assinar</button>
          </section>
        </aside>
      </main>
    </div>

    <nav class="mobile-nav" aria-label="Navegação móvel">
      <button class="mobile-tab active" data-target="home">⌂</button>
      <button class="mobile-tab" data-target="feed">◌</button>
      <button class="mobile-tab" data-target="stories">◍</button>
      <button class="mobile-tab" data-target="chat">✦</button>
      <a class="mobile-tab" href="profile.html">☰</a>
    </nav>

    <div class="toast" id="toast"></div>
    <script src="app.js"></script>
  </body>
</html>

